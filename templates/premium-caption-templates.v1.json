{
  "schemaVersion": "1.0.0",
  "name": "Gana Caption Studio - Premium Caption Templates",
  "meta": {
    "status": "Design specification taken from a browser (CSS and Web Animations) preview. NOT yet tested in exported video. Do not treat any effect as supported until it renders correctly in your exporter.",
    "units": "Sizes written 'cqw' are percent of the video frame WIDTH (1cqw = 1% of frame width). Positions top/bottom/left/right are percent of the frame unless marked cqw. 'em' is relative to the layer's own font size. Durations are milliseconds.",
    "timing": "Word timing must come from your transcription provider. Never invent word timestamps. 'previewWordMs' (340) was used only in the demo preview.",
    "wordInput": {
      "text": "string",
      "start": "seconds (from transcript)",
      "end": "seconds (from transcript)",
      "isKeyword": "optional boolean, set by the user or an auto-picker"
    },
    "grouping": "Phrases of about 2 to 4 words. Each phrase has one keyword (keywordIndex). Words before the keyword are 'before', words after are 'after'.",
    "fontsRequired": [
      {"family": "Inter", "weights": [500, 600, 800]},
      {"family": "Instrument Serif", "styles": ["normal", "italic"], "weights": [400]},
      {"family": "Poppins", "weights": [800, 900]},
      {"family": "JetBrains Mono", "weights": [500]},
      {"family": "Noto Sans Telugu", "weights": [600, 800], "use": "Telugu fallback for every template"}
    ],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;800&family=Instrument+Serif:ital@0;1&family=Poppins:wght@800;900&family=JetBrains+Mono:wght@500&family=Noto+Sans+Telugu:wght@600;800&display=swap",
    "telugu": "The Latin display fonts have no Telugu glyphs. Telugu text falls back to Noto Sans Telugu 800, so the distinctive typefaces only show in English. Letter-spacing is set to 0 and uppercase is disabled for Telugu.",
    "sampleCopyNote": "Sample phrases come from the user's own script. They have not been fact-checked."
  },
  "easing": {
    "expoOut": "cubic-bezier(.16,1,.3,1)",
    "overshoot": "cubic-bezier(.34,1.56,.64,1)",
    "easeInOutCubic": "cubic-bezier(.645,.045,.355,1)",
    "cubicOut": "cubic-bezier(.215,.61,.355,1)",
    "cubicIn": "cubic-bezier(.55,.055,.675,.19)",
    "linear": "linear",
    "easeOut": "ease-out",
    "easeInOut": "ease-in-out"
  },
  "accentPalettes": {
    "default": "indigo",
    "palettes": {
      "indigo": ["#6366f1", "#22d3ee"],
      "emerald": ["#10b981", "#a3e635"],
      "orange": ["#f97316", "#facc15"],
      "pink": ["#ec4899", "#8b5cf6"]
    },
    "usedBy": ["gana_mask_rise", "gana_command_bar", "gana_metric_counter"]
  },
  "animationPresets": {
    "entrance": {
      "fadeCubicIn": {"label": "Fade cubic in", "easing": "cubicOut", "keyframes": [{"opacity": 0}, {"opacity": 1}]},
      "scalePop": {"label": "Scale pop", "easing": "overshoot", "keyframes": [{"opacity": 0, "transform": "scale(.6)"}, {"opacity": 1, "transform": "scale(1)"}]},
      "overshootPositionScale": {"label": "Overshoot position and scale", "easing": "overshoot", "keyframes": [{"opacity": 0, "transform": "translateY(5cqw) scale(.85)"}, {"opacity": 1, "transform": "translateY(0) scale(1)"}]}
    },
    "exit": {
      "gaussianBlurFadeEased": {"label": "Gaussian blur and fade eased", "easing": "easeInOutCubic", "params": {"blurPx": 3}, "keyframes": [{"opacity": 1, "filter": "blur(0px)"}, {"opacity": 0, "filter": "blur({blurPx}px)"}]},
      "cubicFade": {"label": "Cubic fade", "easing": "cubicIn", "keyframes": [{"opacity": 1}, {"opacity": 0}]},
      "scaleDownExit": {"label": "Scale-down exit", "easing": "easeInOutCubic", "keyframes": [{"opacity": 1, "transform": "scale(1)"}, {"opacity": 0, "transform": "scale(.8)"}]}
    }
  },
  "templates": [
    {
      "id": "gana_editorial_italic",
      "name": "Editorial Italic",
      "order": 1,
      "controls": {
        "entrancePreset": {"options": ["fadeCubicIn", "scalePop", "overshootPositionScale"], "default": "fadeCubicIn"},
        "exitPreset": {"options": ["gaussianBlurFadeEased", "cubicFade", "scaleDownExit"], "default": "gaussianBlurFadeEased"},
        "keywordColor": {"options": {"White": "#ffffff", "Cream": "#f4ead5", "Cyan": "#5fe3ee", "Gold": "#f1cf7a"}, "default": "#ffffff"},
        "durationMs": {"min": 200, "max": 1200, "default": 600},
        "exitBlurPx": {"min": 0, "max": 30, "default": 3},
        "sizePercent": {"min": 80, "max": 130, "default": 100}
      },
      "layout": {
        "anchor": {"top": "50%", "left": 0, "right": 0},
        "direction": "column",
        "align": "center",
        "gap": "1cqw",
        "paddingX": "6cqw",
        "structure": ["beforeLine", "keyword", "afterLine"],
        "reserveHeight": {"beforeLine": "1.3em", "keyword": ".95em", "afterLine": "1.3em"},
        "note": "reserveHeight avoids layout shift while words appear one by one. Only reserve a line if the phrase has words for it."
      },
      "layers": {
        "beforeLine": {"font": "Inter", "weight": 500, "size": "4.8cqw", "letterSpacing": ".04em", "color": "#f3ede2", "wordGap": ".45em", "textShadow": "0 1px 14px rgba(0,0,0,.35)"},
        "afterLine": {"font": "Inter", "weight": 500, "size": "4.8cqw", "letterSpacing": ".04em", "color": "#f3ede2", "wordGap": ".45em", "textShadow": "0 1px 14px rgba(0,0,0,.35)"},
        "keyword": {"font": "Instrument Serif", "style": "italic", "weight": 400, "size": "25cqw", "lineHeight": 0.95, "letterSpacing": "-.02em", "color": "{keywordColor}", "textShadow": "0 4px 30px rgba(0,0,0,.35)"}
      },
      "timing": {
        "reveal": "wordByWord at each word's start time",
        "entrance": "{entrancePreset}",
        "entranceDurationMs": "{durationMs}",
        "keywordDurationMultiplier": 1.3,
        "holdAfterLastWordMs": 700,
        "exit": "{exitPreset}",
        "exitAppliesTo": "whole group",
        "exitDurationMs": "{durationMs}",
        "gapAfterExitMs": 150
      },
      "telugu": {"layers": {"beforeLine": {"letterSpacing": "0"}, "afterLine": {"letterSpacing": "0"}, "keyword": {"font": "Noto Sans Telugu", "style": "normal", "weight": 800, "size": "16cqw", "letterSpacing": "0"}}}
    },
    {
      "id": "gana_cinematic_kinetic",
      "name": "Cinematic Kinetic",
      "order": 2,
      "controls": {
        "entrancePreset": {"options": ["fadeCubicIn", "scalePop", "overshootPositionScale"], "default": "fadeCubicIn"},
        "exitPreset": {"options": ["gaussianBlurFadeEased", "cubicFade", "scaleDownExit"], "default": "gaussianBlurFadeEased"},
        "keywordColor": {"options": {"White": "#ffffff", "Cream": "#f4ead5", "Cyan": "#5fe3ee", "Gold": "#f1cf7a"}, "default": "#ffffff"},
        "durationMs": {"min": 200, "max": 1200, "default": 600},
        "exitBlurPx": {"min": 0, "max": 30, "default": 3},
        "sizePercent": {"min": 80, "max": 130, "default": 100}
      },
      "layout": {
        "direction": "column",
        "structure": ["beforeLine", "keyword", "afterLine"],
        "maxWidth": "100%",
        "positionsByPhraseIndex": {
          "cycle": true,
          "positions": [
            {"top": "36%", "left": 0, "right": 0, "align": "center", "textAlign": "center"},
            {"bottom": "20%", "left": "7cqw", "right": "7cqw", "align": "flex-start", "textAlign": "left"},
            {"top": "18%", "left": "7cqw", "right": "7cqw", "align": "flex-end", "textAlign": "right"},
            {"top": "46%", "left": 0, "right": 0, "align": "center", "textAlign": "center"}
          ]
        }
      },
      "layers": {
        "beforeLine": {"font": "Poppins", "weight": 800, "size": "5.2cqw", "letterSpacing": "-.01em", "color": "#f3ede2", "textShadow": "0 2px 12px rgba(0,0,0,.35)"},
        "afterLine": {"font": "Poppins", "weight": 800, "size": "5.2cqw", "letterSpacing": "-.01em", "color": "#f3ede2", "textShadow": "0 2px 12px rgba(0,0,0,.35)"},
        "keyword": {"font": "Poppins", "weight": 900, "size": "15cqw", "lineHeight": 1.02, "letterSpacing": "-.05em", "color": "{keywordColor}", "whiteSpace": "nowrap", "textShadow": "0 2px 14px rgba(0,0,0,.35)"}
      },
      "timing": {
        "reveal": "whole phrase at once (group-level), layers staggered",
        "entranceStaggerMs": 140,
        "entrance": "{entrancePreset}",
        "entranceDurationMs": "{durationMs}",
        "holdMs": "phrase duration from the transcript (preview used wordCount x previewWordMs)",
        "exit": "{exitPreset}",
        "exitStaggerMs": 80,
        "exitDurationMs": "{durationMs}"
      },
      "telugu": {"layers": {"keyword": {"font": "Noto Sans Telugu", "weight": 800, "letterSpacing": "0"}}}
    },
    {
      "id": "gana_mask_rise",
      "name": "Mask Rise",
      "order": 3,
      "accent": "palette",
      "controls": {"accent": {"options": ["indigo", "emerald", "orange", "pink"], "default": "indigo"}, "sizePercent": {"min": 80, "max": 130, "default": 100}},
      "layout": {"anchor": {"top": "48%", "left": "8cqw", "right": "8cqw"}, "direction": "column", "align": "flex-start", "textAlign": "left", "gap": "3.4cqw", "structure": ["eyebrow", "headline"]},
      "layers": {
        "eyebrow": {"font": "JetBrains Mono", "weight": 500, "size": "2.5cqw", "letterSpacing": ".12em", "color": "rgba(255,255,255,.85)", "background": "rgba(255,255,255,.08)", "border": "1px solid rgba(255,255,255,.22)", "radius": "pill", "padding": "1.1cqw 2.8cqw", "dot": {"size": "1.5cqw", "color": "{accent[0]}", "glow": "0 0 1.6cqw {accent[0]}"}, "textSource": "user-defined label per phrase (sample: '01 · NEWS')"},
        "headline": {"font": "Inter", "weight": 800, "size": "10.5cqw", "letterSpacing": "-.05em", "lineHeight": 1.08, "color": "#ffffff", "wordGap": ".24em", "filter": "drop-shadow(0 .6cqw 1.6cqw rgba(0,0,0,.4))"},
        "wordMask": {"overflow": "hidden", "padding": ".06em .04em .2em", "margin": "-.06em -.04em -.2em"},
        "keywordFill": {"gradient": "linear-gradient(90deg,{accent[0]},{accent[1]})", "shine": "linear-gradient(100deg,transparent 35%,rgba(255,255,255,.9) 50%,transparent 65%)", "shineBackgroundSize": "300% 100%", "note": "text fill via background-clip:text"},
        "underline": {"height": ".07em", "left": ".04em", "right": ".04em", "bottom": ".06em", "radius": "9px", "gradient": "linear-gradient(90deg,{accent[0]},{accent[1]})", "transformOrigin": "left center"}
      },
      "timing": {
        "eyebrowIn": {"easing": "expoOut", "durationMs": 600, "keyframes": [{"opacity": 0, "transform": "translateY(8px)"}, {"opacity": 1, "transform": "translateY(0)"}]},
        "wordIn": {"at": "each word's start time", "easing": "expoOut", "durationMs": 750, "keyframes": [{"transform": "translateY(115%)"}, {"transform": "translateY(0)"}]},
        "keywordUnderline": {"delayMs": 350, "durationMs": 600, "easing": "expoOut", "keyframes": [{"transform": "scaleX(0)"}, {"transform": "scaleX(1)"}]},
        "keywordShine": {"delayMs": 700, "durationMs": 1200, "easing": "easeInOut", "keyframes": [{"backgroundPosition": "120% 0,0 0"}, {"backgroundPosition": "-20% 0,0 0"}]},
        "holdAfterLastWordMs": 900,
        "wordOut": {"easing": "easeInOutCubic", "durationMs": 500, "staggerMs": 40, "keyframes": [{"transform": "translateY(0)"}, {"transform": "translateY(-115%)"}]},
        "eyebrowAndUnderlineOut": {"easing": "easeInOutCubic", "durationMs": 400, "keyframes": [{"opacity": 1}, {"opacity": 0}]}
      }
    },
    {
      "id": "gana_command_bar",
      "name": "Command Bar",
      "order": 4,
      "accent": "palette",
      "controls": {"accent": {"options": ["indigo", "emerald", "orange", "pink"], "default": "indigo"}, "sizePercent": {"min": 80, "max": 130, "default": 100}},
      "layout": {"anchor": {"top": "50%", "left": "6cqw", "right": "6cqw"}, "structure": ["header", "text", "footer"]},
      "layers": {
        "bar": {"padding": "3.6cqw 4cqw 3cqw", "radius": "4.4cqw", "background": "rgba(16,18,26,.74)", "backdropFilter": "blur(18px) saturate(1.5)", "border": "1px solid rgba(255,255,255,.14)", "boxShadow": "0 3cqw 9cqw rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.12)", "note": "Backdrop blur needs footage behind the bar. On a transparent export it renders as a translucent dark bar with no blur."},
        "header": {"font": "JetBrains Mono", "weight": 500, "size": "2.4cqw", "color": "rgba(255,255,255,.55)", "marginBottom": "2.8cqw", "left": {"kbd": "⌘ K"}, "right": {"text": "captions"}, "kbdStyle": {"padding": ".6cqw 1.6cqw", "radius": "1.2cqw", "border": "1px solid rgba(255,255,255,.2)", "background": "rgba(255,255,255,.08)", "color": "rgba(255,255,255,.8)"}, "note": "UI labels are placeholders and can be edited."},
        "text": {"font": "Inter", "weight": 600, "size": "6.4cqw", "letterSpacing": "-.02em", "lineHeight": 1.45, "color": "#ffffff", "minHeight": "9cqw", "gap": ".6cqw .28em"},
        "keywordChip": {"padding": ".02em .4em", "radius": ".36em", "color": "#ffffff", "background": "rgba(accent[0],.22)", "border": "1px solid rgba(accent[0],.65)", "glow": "0 0 3cqw rgba(accent[0],.3)", "leadingDot": {"size": ".34em", "color": "{accent[0]}"}},
        "caret": {"width": ".1em", "height": "1em", "color": "{accent[0]}", "blink": {"durationMs": 1000, "easing": "steps(1)"}},
        "footer": {"font": "JetBrains Mono", "weight": 500, "size": "2.4cqw", "color": "rgba(255,255,255,.55)", "marginTop": "3cqw", "paddingTop": "2.4cqw", "borderTop": "1px solid rgba(255,255,255,.1)", "left": {"text": "press enter to run"}, "right": {"kbd": "↵"}}
      },
      "timing": {
        "barIn": {"easing": "expoOut", "durationMs": 500, "keyframes": [{"opacity": 0, "transform": "translateY(14px)"}, {"opacity": 1, "transform": "translateY(0)"}], "waitAfterMs": 550},
        "wordIn": {"at": "each word's start time", "easing": "expoOut", "durationMs": 180, "keyframes": [{"opacity": 0, "transform": "translateY(4px)"}, {"opacity": 1, "transform": "translateY(0)"}]},
        "keywordChipIn": {"easing": "overshoot", "durationMs": 280, "keyframes": [{"opacity": 0, "transform": "scale(.8)"}, {"opacity": 1, "transform": "scale(1)"}]},
        "enterKeyPress": {"afterLastWordMs": 250, "hideCaret": true, "keyFlash": {"background": "{accent[0]}", "color": "#ffffff"}, "press": {"easing": "easeOut", "durationMs": 260, "keyframes": [{"transform": "scale(1)"}, {"transform": "scale(.86)"}, {"transform": "scale(1)"}]}, "ripple": {"easing": "easeOut", "durationMs": 600, "keyframes": [{"boxShadow": "0 0 0 0 rgba(accent[0],.6)"}, {"boxShadow": "0 0 0 3cqw rgba(accent[0],0)"}]}},
        "holdAfterPressMs": 900,
        "barOut": {"easing": "easeInOutCubic", "durationMs": 450, "keyframes": [{"opacity": 1, "transform": "scale(1)", "filter": "blur(0px)"}, {"opacity": 0, "transform": "scale(.97)", "filter": "blur(3px)"}]}
      }
    },
    {
      "id": "gana_metric_counter",
      "name": "Metric Counter",
      "order": 5,
      "accent": "palette",
      "controls": {"accent": {"options": ["indigo", "emerald", "orange", "pink"], "default": "indigo"}, "sizePercent": {"min": 80, "max": 130, "default": 100}},
      "layout": {"anchor": {"top": "40%", "left": 0, "right": 0}, "direction": "column", "align": "center", "textAlign": "center", "gap": "2.6cqw", "structure": ["label", "numberRow", "sparkline"]},
      "keywordParsing": {"numericPattern": "^(\\D*)(\\d+(?:\\.\\d+)?)(\\D*)$", "groups": ["prefix", "value", "suffix"], "decimals": "count of digits after the decimal point in 'value'", "fallback": "If the keyword is not numeric, show it as a large gradient word with a shine sweep and no sparkline."},
      "layers": {
        "label": {"font": "Inter", "weight": 600, "size": "3.6cqw", "letterSpacing": ".18em", "uppercase": true, "color": "rgba(255,255,255,.78)", "wordGap": ".6em", "minHeight": "1.4em", "paddingX": "6cqw", "textShadow": "0 1px 10px rgba(0,0,0,.4)", "content": "all non-keyword words, in order"},
        "numberRow": {"font": "Inter", "weight": 800, "letterSpacing": "-.06em", "lineHeight": 1, "tabularNumbers": true, "filter": "drop-shadow(0 .8cqw 2cqw rgba(0,0,0,.45))", "prefix": {"size": "11cqw", "marginTop": "2.4cqw", "fill": "linear-gradient(90deg,{accent[0]},{accent[1]})"}, "number": {"size": "22cqw", "color": "#ffffff", "margin": "0 .02em"}, "suffix": {"size": "14cqw", "marginTop": "5cqw", "fill": "linear-gradient(90deg,{accent[0]},{accent[1]})"}},
        "fallbackWord": {"font": "Inter", "weight": 800, "size": "17cqw", "paddingX": "3cqw", "fill": "linear-gradient(90deg,{accent[0]},{accent[1]})", "shine": "linear-gradient(100deg,transparent 35%,rgba(255,255,255,.9) 50%,transparent 65%)"},
        "sparkline": {"width": "58cqw", "height": "11cqw", "viewBox": "0 0 100 30", "preserveAspectRatio": "none", "path": "M0 26 C12 24 18 20 28 21 S44 12 56 13 S76 6 100 3", "strokeWidthPx": 3, "strokeLinecap": "round", "strokeGradient": [{"offset": 0, "color": "{accent[0]}", "opacity": 0.25}, {"offset": 1, "color": "{accent[1]}", "opacity": 1}], "endDot": {"size": "2.2cqw", "color": "{accent[1]}", "glow": "0 0 3cqw {accent[1]}", "right": "-1.1cqw", "top": "3%"}}
      },
      "timing": {
        "labelWordIn": {"at": "each non-keyword word's start time", "easing": "expoOut", "durationMs": 260, "keyframes": [{"opacity": 0, "transform": "translateY(6px)"}, {"opacity": 1, "transform": "translateY(0)"}]},
        "numberRowIn": {"at": "keyword's start time", "easing": "expoOut", "durationMs": 550, "keyframes": [{"opacity": 0, "filter": "blur(10px)", "transform": "scale(.92)"}, {"opacity": 1, "filter": "blur(0px)", "transform": "scale(1)"}]},
        "countUp": {"durationMs": 1100, "curve": "easeOutExpo: v = 1 - 2^(-10 t), t in 0..1", "from": 0, "to": "value", "formatting": "fixed decimals"},
        "sparklineFade": {"durationMs": 300},
        "sparklineDraw": {"easing": "expoOut", "durationMs": 1100, "technique": "stroke-dasharray 1 with pathLength 1, offset 1 to 0"},
        "endDotIn": {"delayMs": 950, "durationMs": 350, "easing": "overshoot", "keyframes": [{"opacity": 0, "transform": "scale(.2)"}, {"opacity": 1, "transform": "scale(1)"}]},
        "fallbackShine": {"delayMs": 500, "durationMs": 1200, "easing": "easeInOut", "keyframes": [{"backgroundPosition": "120% 0,0 0"}, {"backgroundPosition": "-20% 0,0 0"}]},
        "holdAfterLastWordMs": {"numeric": 1100, "fallback": 800},
        "groupOut": {"easing": "easeInOutCubic", "durationMs": 450, "keyframes": [{"opacity": 1, "filter": "blur(0px)", "transform": "translateY(0)"}, {"opacity": 0, "filter": "blur(4px)", "transform": "translateY(-8px)"}]}
      }
    }
  ],
  "sample": {
    "previewWordMs": 340,
    "note": "Demo phrases only. Timing is fixed and not from a real transcription.",
    "en": [
      {"words": ["india's", "newest", "ai", "unicorn"], "keywordIndex": 3, "eyebrow": "01 · NEWS"},
      {"words": ["they", "raised", "$234M"], "keywordIndex": 2, "eyebrow": "02 · FUNDING"},
      {"words": ["at", "a", "$1.5B", "valuation"], "keywordIndex": 2, "eyebrow": "03 · VALUATION"},
      {"words": ["built", "in", "india"], "keywordIndex": 2, "eyebrow": "04 · MISSION"}
    ],
    "te": [
      {"words": ["భయం", "వదిలేయ్"], "keywordIndex": 1, "eyebrow": "01"},
      {"words": ["ఇప్పుడే", "మొదలుపెట్టు"], "keywordIndex": 1, "eyebrow": "02"},
      {"words": ["నువ్వు", "చేయగలవు"], "keywordIndex": 1, "eyebrow": "03"}
    ]
  }
}